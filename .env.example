# Exemplo sem credenciais reais. Complete o seu .env existente; não o sobrescreva.
AWS_DEFAULT_REGION=us-east-1
# Para o deploy, cadastre no GitHub Variables (o workflow não lê este arquivo):
# AWS_REGION=us-east-1
# GLUE_JOB_NAME=nome-do-job-existente
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/JobsGlue
# ARTIFACTS_BUCKET=meu-bucket-artefatos
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Apenas para credenciais temporárias

BRONZE_BUCKET=meu-bucket-bronze
SILVER_BUCKET=meu-bucket-silver
# SOURCE_BUCKET também é aceito; tem prioridade sobre BRONZE_BUCKET.
SOURCE_PREFIX=compras/sc7/
SOURCE_KEY=compras/sc7/arquivo.csv
# SOURCE_VERSION_ID=
DATABASE=silver_compras
TABLE=sc7_pedidos_compra
TABLE_LOCATION=iceberg/sc7_pedidos_compra/
TEMP_PATH=staging/sc7_pedidos_compra/
S3_OUTPUT=athena-results/
WORKGROUP=silver-compras

MERGE_KEYS=r_e_c_n_o
DELETION_COLUMN=d_e_l_e_t_d
DATE_COLUMN=extraction_date
DATE_FORMAT=ISO8601
CSV_SEPARATOR=";"
ENCODING=utf-8
DECIMAL_SEPARATOR=.
C7_EMISSAO_FORMAT=%Y%m%d
C7_DATPRF_FORMAT=%Y%m%d
